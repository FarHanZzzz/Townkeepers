# Copy to .env and replace every placeholder. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://townhall:REPLACE_PASSWORD@localhost:5432/townhall
TEST_DATABASE_NAME=test_townhall

# IUB supplies eligible hosted domains and the Google client (PRD Appendix C.2).
# Empty IUB_ALLOWED_DOMAINS denies every live sign-in.
IUB_ALLOWED_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development-only persona picker for seeded synthetic profiles. Rejected in production settings.
DEMO_AUTH=true

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=townhall-noreply@townhall.test
SITE_BASE_URL=http://127.0.0.1:8000

PRIVATE_MEDIA_ROOT=
MAX_UPLOAD_BYTES=10485760

ASSISTANCE_URL=http://127.0.0.1:8001
ASSISTANCE_SERVICE_TOKEN=replace-with-a-random-service-token
ASSISTANCE_TIMEOUT_SECONDS=5
